{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Visa Sponsor Checker",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://nl.linkedin.com/*"
      ],
      "js": [
        "lib/sponsor.js",
        "shared/lines.js",
        "content/common.js",
        "content/linkedin.js"
      ],
      "css": [
        "content/badges.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://nl.indeed.com/*"
      ],
      "js": [
        "lib/sponsor.js",
        "shared/lines.js",
        "content/common.js",
        "content/indeed.js"
      ],
      "css": [
        "content/badges.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "homepage_url": "https://werkcv.nl/en/chrome/visa-sponsor-checker"
}
