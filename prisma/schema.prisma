generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}
datasource db {
  provider = "postgresql"
}

model User {
  id                    String                @id @default(uuid())
  email                 String                @unique
  attribution           Json?
  sourceCluster         String?
  sourceLocale          String?
  sourcePath            String?
  createdAt             DateTime              @default(now())
  documents             CVDocument[]
  sessions              Session[]
  pilotAccess           PilotAccess?
  agencySubscription    AgencySubscription?
  agencyMatchPacks      AgencyMatchPack[]
  agencyTeamMemberships AgencyTeamMember[]
  agencyTemplates       AgencyTemplate[]
  profilePhotoProjects  ProfilePhotoProject[]
}

model PilotAccess {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  notes     String?
  createdAt DateTime @default(now())

  @@unique([userId])
  @@index([userId])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model LoginCode {
  id        String    @id @default(uuid())
  email     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}

model CVDocument {
  id                   String           @id @default(uuid())
  title                String
  data                 Json
  templateId           String           @default("professional")
  colorThemeId         String           @default("classic-blue")
  coverLetter          String?          @db.Text
  coverLetterUpdatedAt DateTime?
  attribution          Json?
  sourceCluster        String?
  sourceLocale         String?
  startSource          String?
  publicClaimKey       String?          @unique
  userId               String?
  user                 User?            @relation(fields: [userId], references: [id])
  agencySubscriptionId String?
  agencySubscription   AgencySubscription? @relation("AgencyCvDocuments", fields: [agencySubscriptionId], references: [id], onDelete: Restrict)
  hasMeaningfulContent Boolean @default(false)
  meaningfulContentAt  DateTime?
  meaningfulContentSignals Json?
  matchPack            AgencyMatchPack?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([agencySubscriptionId, updatedAt])
  @@index([userId, agencySubscriptionId, updatedAt])
  @@index([userId, agencySubscriptionId, hasMeaningfulContent])
  @@index([meaningfulContentAt])
}

model AgencyMatchPack {
  id                    String                    @id @default(cuid())
  userId                String
  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                 String
  vacancyTitle          String?
  vacancyText           String                    @db.Text
  locale                String                    @default("nl")
  sourceFileType        String?
  sourceText            String?                   @db.Text
  sourceMap             Json?
  sourceTextDigest      String?
  originalCandidateData Json?
  candidateData         Json
  anonymizedData        Json
  analysis              Json
  claimVerificationData Json?
  submissionData        Json?
  outcomeData           Json?
  templateId            String                    @default("professional")
  colorThemeId          String                    @default("classic-blue")
  agencyTemplateId      String?
  agencyTemplate        AgencyTemplate?           @relation(fields: [agencyTemplateId], references: [id], onDelete: SetNull)
  status                String                    @default("analyzed")
  cvDocumentId          String?                   @unique
  cvDocument            CVDocument?               @relation(fields: [cvDocumentId], references: [id], onDelete: SetNull)
  approvedAt            DateTime?
  approvedById          String?
  approvalData          Json?
  approvedRevisionVersion Int?
  approvedSnapshotDigest String?
  firstExportedAt       DateTime?
  correctionsCount      Int                       @default(0)
  unsupportedClaimsCaught Int                     @default(0)
  clientOutcome         String                    @default("unknown")
  clientOutcomeRecordedAt DateTime?
  clientOutcomeRecordedById String?
  productFeedbackData   Json?
  retentionExpiresAt    DateTime?
  revisions             AgencyMatchPackRevision[]
  candidateReviews      AgencyCandidateReview[]
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([userId, updatedAt])
  @@index([userId, status])
  @@index([retentionExpiresAt, status])
}

model AgencyMatchPackRevision {
  id             String          @id @default(cuid())
  matchPackId    String
  matchPack      AgencyMatchPack @relation(fields: [matchPackId], references: [id], onDelete: Cascade)
  version        Int
  reason         String          @default("draft_saved")
  candidateData  Json
  submissionData Json
  analysis       Json
  claimVerificationData Json?
  changedFields  String[]        @default([])
  createdById    String
  createdAt      DateTime        @default(now())

  @@unique([matchPackId, version])
  @@index([matchPackId, createdAt])
}

model AgencyTemplate {
  id           String            @id @default(cuid())
  ownerId      String
  owner        User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  templateId   String            @default("professional")
  colorThemeId String            @default("classic-blue")
  companyName  String?
  website      String?
  headerText   String?
  footerText   String?
  isDefault    Boolean           @default(false)
  matchPacks   AgencyMatchPack[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([ownerId, isDefault])
}

model Template {
  id      String @id @default(uuid())
  name    String
  preview String
  config  Json
}

model Order {
  id                  String               @id @default(uuid())
  email               String
  cvId                String?
  product             String
  amountCents         Int?
  currency            String?
  addons              String[]             @default([])
  attribution         Json?
  sourceCluster       String?
  lemonId             String?              @unique
  paidAt              DateTime?
  createdAt           DateTime             @default(now())
  profilePhotoProject ProfilePhotoProject?
}

model PaymentCheckout {
  id                 String    @id @default(cuid())
  provider           String
  externalCheckoutId String    @unique
  cvId               String?
  email              String?
  siteHost           String?
  product            String?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([provider, createdAt])
  @@index([cvId])
}

model AgencySubscription {
  id                     String                  @id @default(cuid())
  userId                 String                  @unique
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  planCode               String                  @default("agency")
  provider               String                  @default("dodo")
  status                 String                  @default("pending")
  productId              String?
  externalSubscriptionId String?                 @unique
  externalCustomerId     String?
  checkoutSessionId      String?                 @unique
  companyName            String?
  website                String?
  monthlyLimit           Int                     @default(300)
  templateId             String                  @default("professional")
  colorThemeId           String                  @default("classic-blue")
  retentionDays          Int                     @default(90)
  retentionPolicySetAt   DateTime?
  retentionUpdatedAt     DateTime?
  onboardingDismissedAt  DateTime?
  onboardingExampleViewedAt DateTime?
  excludeFromProductMetrics Boolean               @default(false)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean                 @default(false)
  canceledAt             DateTime?
  metadata               Json?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  usagePeriods           AgencyUsagePeriod[]
  payments               AgencyPayment[]
  teamMembers            AgencyTeamMember[]
  deletionReceipts       AgencyDeletionReceipt[]
  transactionalEmails    AgencyTransactionalEmail[]
  candidateReviews       AgencyCandidateReview[]
  legalName              String?
  privacyPolicyUrl       String?
  privacyContactEmail    String?
  cvDocuments            CVDocument[]          @relation("AgencyCvDocuments")

  @@index([status, currentPeriodEnd])
  @@index([externalCustomerId])
}

model AgencyTransactionalEmail {
  id             String             @id @default(cuid())
  subscriptionId String
  subscription   AgencySubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  kind           String
  dedupeKey      String             @unique
  entityType     String?
  entityId       String?
  recipientEmail String
  locale         String             @default("nl")
  status         String             @default("pending")
  attemptCount   Int                @default(0)
  claimedAt      DateTime?
  sentAt         DateTime?
  lastErrorCode  String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([entityType, entityId])
}

model AgencyCandidateReview {
  id                    String                              @id @default(cuid())
  subscriptionId        String
  subscription          AgencySubscription                  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  matchPackId           String
  matchPack             AgencyMatchPack                     @relation(fields: [matchPackId], references: [id], onDelete: Cascade)
  revisionVersion       Int
  snapshotDigest        String
  snapshotData          Json
  candidateEmail        String
  recipientOrganization String
  vacancyTitle          String
  selectedVariant       String
  locale                String                              @default("nl")
  statementVersion      String                              @default("candidate_acknowledgement_v1")
  status                String                              @default("draft")
  tokenHash             String?                             @unique
  tokenExpiresAt        DateTime?
  tokenConsumedAt       DateTime?
  invitedAt             DateTime?
  sentAt                DateTime?
  openedAt              DateTime?
  respondedAt           DateTime?
  revokedAt             DateTime?
  candidateResponse     String?
  overrideReason        String?
  overriddenAt          DateTime?
  overriddenById        String?
  createdById           String
  retentionExpiresAt    DateTime?
  sessions              AgencyCandidateReviewSession[]
  suggestions           AgencyCandidateReviewSuggestion[]
  events                AgencyCandidateReviewEvent[]
  createdAt             DateTime                            @default(now())
  updatedAt             DateTime                            @updatedAt

  @@unique([matchPackId, revisionVersion, snapshotDigest])
  @@index([matchPackId, status, createdAt])
  @@index([subscriptionId, createdAt])
  @@index([retentionExpiresAt, status])
}

model AgencyCandidateReviewSession {
  id          String                @id @default(cuid())
  reviewId    String
  review      AgencyCandidateReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  secretHash  String                @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime              @default(now())

  @@index([reviewId, expiresAt])
}

model AgencyCandidateReviewSuggestion {
  id             String                @id @default(cuid())
  reviewId       String
  review         AgencyCandidateReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  targetType     String
  targetPath     String
  originalValue  String                @db.Text
  proposedValue  String                @db.Text
  candidateNote  String                @default("") @db.Text
  status         String                @default("pending")
  resolvedById   String?
  resolvedAt     DateTime?
  reviewerNote   String                @default("") @db.Text
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([reviewId, status])
}

model AgencyCandidateReviewEvent {
  id          String                @id @default(cuid())
  reviewId    String
  review      AgencyCandidateReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  type        String
  actorType   String
  actorUserId String?
  metadata    Json?
  createdAt   DateTime              @default(now())

  @@index([reviewId, createdAt])
  @@index([type, createdAt])
}

model AgencyTeamMember {
  id             String             @id @default(cuid())
  subscriptionId String
  subscription   AgencySubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  email          String
  role           String             @default("editor")
  status         String             @default("invited")
  invitedAt      DateTime           @default(now())
  acceptedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([subscriptionId, email])
  @@index([email, status])
}

model AgencyDeletionReceipt {
  id                 String             @id @default(cuid())
  subscriptionId     String
  subscription       AgencySubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  actorUserId        String?
  reason             String
  matchPacksDeleted  Int                @default(0)
  revisionsDeleted   Int                @default(0)
  cvDocumentsDeleted Int                @default(0)
  templatesDeleted   Int                @default(0)
  teamMembersDeleted Int                @default(0)
  retentionDays      Int?
  createdAt          DateTime           @default(now())

  @@index([subscriptionId, createdAt])
}

model AgencyUsagePeriod {
  id             String             @id @default(cuid())
  subscriptionId String
  subscription   AgencySubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  startsAt       DateTime
  endsAt         DateTime
  allowance      Int                @default(300)
  createdAt      DateTime           @default(now())
  cvUsages       AgencyCvUsage[]

  @@unique([subscriptionId, startsAt])
  @@index([subscriptionId, endsAt])
}

model AgencyCvUsage {
  id        String            @id @default(cuid())
  periodId  String
  period    AgencyUsagePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  cvId      String
  countedAt DateTime          @default(now())

  @@unique([periodId, cvId])
  @@index([periodId, countedAt])
}

model AgencyPayment {
  id                String             @id @default(cuid())
  subscriptionId    String
  subscription      AgencySubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  externalPaymentId String             @unique
  checkoutSessionId String?
  amountCents       Int?
  currency          String?
  status            String             @default("paid")
  paidAt            DateTime?
  metadata          Json?
  createdAt         DateTime           @default(now())

  @@index([subscriptionId, paidAt])
  @@index([checkoutSessionId])
}

model ProfilePhotoProject {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId          String?  @unique
  order            Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  status           String   @default("pending")
  style            String?
  sourceImageCount Int      @default(0)
  generationCount  Int      @default(0)
  refinementCount  Int      @default(0)
  images           Json?
  attribution      Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  event       String
  dedupeKey   String?  @unique
  cvId        String?
  orderId     String?
  path        String?
  cluster     String?
  properties  Json?
  attribution Json?
  createdAt   DateTime @default(now())

  @@index([event, createdAt])
  @@index([cvId])
  @@index([orderId])
}

model FollowupContact {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?
  userId    String?
  status    String   @default("active")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([userId])
}

model FollowupTask {
  id             String    @id @default(cuid())
  email          String
  type           String
  status         String    @default("draft")
  reason         String
  draftSubject   String?
  draftBody      String?   @db.Text
  dueAt          DateTime
  sentAt         DateTime?
  skippedReason  String?
  relatedUserId  String?
  relatedCvId    String?
  relatedOrderId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([email, type, relatedCvId])
  @@unique([email, type, relatedOrderId])
  @@index([status, dueAt])
  @@index([email])
  @@index([type])
}

model EmailMessage {
  id          String    @id @default(cuid())
  email       String
  direction   String
  folder      String?
  uid         Int?
  uidValidity Int?
  fromAddress String?
  toAddress   String?
  subject     String?
  bodyPreview String?   @db.Text
  messageId   String?   @unique
  inReplyTo   String?
  sentAt      DateTime?
  receivedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email, receivedAt])
  @@index([direction, receivedAt])
  @@index([folder, uid])
}

model MailboxSyncState {
  id           String    @id @default(cuid())
  folder       String    @unique
  uidValidity  Int?
  lastUid      Int       @default(0)
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model JobSource {
  id                    String          @id @default(cuid())
  slug                  String          @unique
  companyName           String
  companySlug           String
  segment               String?
  city                  String?
  countryCode           String?
  englishFit            JobEnglishFit   @default(medium)
  providerHint          String?
  provider              JobProvider
  sourceKey             String?
  apiUrl                String?         @db.Text
  careersUrl            String          @db.Text
  status                JobSourceStatus @default(research)
  priority              Int             @default(100)
  notes                 String?         @db.Text
  isActive              Boolean         @default(true)
  lastFetchedAt         DateTime?
  lastSuccessfulFetchAt DateTime?
  lastError             String?         @db.Text
  jobs                  Job[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@unique([provider, sourceKey])
  @@index([companySlug])
  @@index([provider, status])
  @@index([status, priority])
}

model Job {
  id                String          @id @default(cuid())
  sourceId          String?
  source            JobSource?      @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  provider          JobProvider
  externalId        String
  companyName       String
  companySlug       String
  title             String
  titleSlug         String
  canonicalSlug     String
  routePath         String          @unique
  locationRaw       String
  city              String?
  citySlug          String?
  countryCode       String?
  remoteMode        JobRemoteMode?
  employmentType    String?
  languageHint      JobLanguageHint @default(unknown)
  dutchRequired     Boolean?
  visaHint          Boolean?
  roleFamily        JobRoleFamily   @default(unknown)
  seniority         JobSeniority    @default(unknown)
  isNlRelevant      Boolean         @default(false)
  isEnglishFriendly Boolean         @default(false)
  isWithoutDutch    Boolean         @default(false)
  status            JobRecordStatus @default(active)
  descriptionText   String          @db.Text
  excerpt           String?         @db.Text
  applyUrl          String          @db.Text
  sourceUrl         String          @db.Text
  postedAt          DateTime?
  firstSeenAt       DateTime        @default(now())
  lastSeenAt        DateTime        @default(now())
  expiresAt         DateTime?
  keywords          String[]
  clusterTags       String[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([provider, externalId])
  @@index([companySlug, titleSlug])
  @@index([countryCode, citySlug, status])
  @@index([isNlRelevant, isEnglishFriendly, status])
  @@index([isWithoutDutch, status])
  @@index([roleFamily, status])
  @@index([seniority, status])
  @@index([lastSeenAt])
}

model JobListingPage {
  id               String         @id @default(cuid())
  slug             String         @unique
  path             String         @unique
  locale           String         @default("nl")
  kind             JobListingKind
  title            String
  heroTitle        String?
  description      String         @db.Text
  metaTitle        String
  metaDesc         String
  introText        String?        @db.Text
  filters          Json
  minJobCount      Int            @default(10)
  minCompanyCount  Int            @default(5)
  primaryCtaHref   String?
  primaryCtaLabel  String?
  relatedGuideHref String?
  isActive         Boolean        @default(true)
  isIndexable      Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([locale, kind, isActive])
}

// SEO Silo Architecture - Categories for CV examples
model CVCategory {
  id          String       @id @default(cuid())
  slug        String       @unique // URL slug: "ict-en-software", "backend-developer-nodejs"
  name        String // Display name: "ICT & Software"
  nameDutch   String // Dutch name for UI
  description String       @db.Text // SEO description for the page
  type        CategoryType // pillar, subhub, or spoke

  // Hierarchy
  parentId String?
  parent   CVCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children CVCategory[] @relation("CategoryHierarchy")

  // Content
  sampleCV  Json? // Pre-filled sample CV data for this niche
  heroTitle String? // Hero section title
  heroText  String?  @db.Text // Hero section description
  tips      String[] // Array of tips for this CV type

  // SEO
  metaTitle String // <title> tag
  metaDesc  String // meta description
  keywords  String[] // Target keywords

  // Sibling linking (for internal links)
  siblingIds String[] // IDs of related categories to link to

  // Tracking
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([type])
}

enum CategoryType {
  pillar // Top-level hub: /cv-voorbeeld/ict-en-software
  subhub // Mid-level: /cv-voorbeeld/ict-en-software/developer
  spoke // Long-tail: /cv-voorbeeld/ict-en-software/backend-developer-nodejs
}

enum JobProvider {
  greenhouse
  lever
  ashby
  workable
}

enum JobSourceStatus {
  research
  pilot
  verified
  paused
}

enum JobEnglishFit {
  high
  medium
  low
}

enum JobRemoteMode {
  remote
  hybrid
  onsite
}

enum JobLanguageHint {
  english
  dutch
  mixed
  unknown
}

enum JobRoleFamily {
  engineering
  data
  product_design
  sales
  marketing
  customer_support
  customer_success
  operations
  finance_accounting
  hr_people
  legal_compliance
  admin_office
  logistics_supply_chain
  general_business
  unknown
}

enum JobSeniority {
  internship
  graduate
  junior
  mid
  senior
  lead
  manager
  director
  executive
  unknown
}

enum JobRecordStatus {
  active
  expired
  hidden
}

enum JobListingKind {
  english_speaking_nl
  without_dutch
  visa_sponsorship
  english_speaking_city
  without_dutch_city
  role_family_nl
  starter_nl
}
