# ─────────────────────────────────────────────────────────
# Database (managed by docker-compose — override if using external DB)
# ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:changeme@db:5432/werkcv
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=werkcv

# ─────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://werkcv.nl

# ─────────────────────────────────────────────────────────
# Google Search Console / GA4 reporting
# ─────────────────────────────────────────────────────────
# The service account must be added as a user of the Search Console property.
GSC_SITE_URL=https://werkcv.nl/
GOOGLE_APPLICATION_CREDENTIALS=C:\\secure\\werkcv-google-service-account.json
GA4_PROPERTY_ID=

# ─────────────────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=replace-with-random-64-char-hex-string
AUTH_FROM_EMAIL=noreply@werkcv.nl
# Local development: show the login code in the login screen instead of sending email.
# Keep false or unset in production.
AUTH_DEV_CODE=true

# ─────────────────────────────────────────────────────────
# Email (SMTP for magic-link login codes)
# Options: Resend, Mailgun, Postmark, or any SMTP provider
# ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here

# ─────────────────────────────────────────────────────────
# AI (OpenAI — for CV parser, ATS rewrite, cover letter)
# ─────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
# Voice CV proposal writing (quality-first default; can be overridden per environment)
OPENAI_VOICE_STRUCTURE_MODEL=gpt-4o
VOICE_CV_PROPOSAL_TIMEOUT_MS=60000

# ─────────────────────────────────────────────────────────
# Payments (Polar)
# ─────────────────────────────────────────────────────────
POLAR_ACCESS_TOKEN=polar_...
POLAR_WEBHOOK_SECRET=whsec_...
POLAR_SERVER=production
# Product IDs from your Polar dashboard
POLAR_PRODUCT_ID_CV_DOWNLOAD=
POLAR_PRICE_ID_CV_DOWNLOAD=
POLAR_PRODUCT_ID_PROFILE_PHOTO=
POLAR_PRODUCT_ID_CV_PROFILE_BUNDLE=
POLAR_PRICE_ID_CV_PROFILE_BUNDLE=
POLAR_PRODUCT_ID_ATS_REWRITE=
POLAR_PRODUCT_ID_COVER_LETTER=
POLAR_PRODUCT_ID_LOCALIZATION=

# Dodo Payments (individual CV download + MatchPack Agency billing tier)
DODO_API_KEY=
DODO_ENVIRONMENT=live_mode
DODO_PRODUCT_ID=
DODO_AGENCY_PRODUCT_ID=
DODO_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────
# Feature flags
# ─────────────────────────────────────────────────────────
PAYMENT_ENABLED=true
